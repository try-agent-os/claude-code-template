{
  "$comment": "AgentOS managed settings — installed to /etc/claude-code/managed-settings.json by install.sh. This file enforces org-wide policy on every claude-code invocation regardless of user-scope or project-scope settings.json.",

  "autoUpdatesChannel": "stable",
  "channelsEnabled": true,
  "minimumVersion": "2.1.132",

  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true
  },

  "forceLoginMethod": "claudeai",

  "allowedChannelPlugins": [
    "claude-peers@agentos",
    "telegram@agentos"
  ],

  "enabledPlugins": [
    "claude-peers@agentos",
    "telegram@agentos",
    "agent-sdk-dev@anthropic",
    "code-review@anthropic",
    "commit-commands@anthropic",
    "security-guidance@anthropic"
  ],

  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*)",
      "Bash(sudo:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=*)",
      "Bash(:(){ :|:& };:)"
    ]
  },

  "strictKnownMarketplaces": [
    "./.claude-plugin/marketplace.json"
  ],

  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "MCP_CONNECTION_NONBLOCKING": "true"
  }
}
