{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "Project-scope settings — committed to repo. Loaded by Claude Code when cwd is at or under this repo's root.",
  "//layering": "Stacked WITH managed-settings.json (highest precedence) and ~/.claude/settings.json (user defaults). Arrays merge across scopes; scalars take most-specific.",

  "permissions": {
    "//": "Project-specific deny/ask/allow patterns. Catastrophic patterns (rm -rf /, fork bomb) live in managed-settings.json — do not duplicate here.",

    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./private/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./.git/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./package-lock.json)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./yarn.lock)",
      "Edit(./Cargo.lock)",
      "Edit(./go.sum)",
      "Edit(./poetry.lock)",
      "Edit(./Pipfile.lock)",
      "Edit(./Gemfile.lock)",
      "Bash(sudo rm *)",
      "Bash(sudo dd *)",
      "Bash(sudo chmod -R *)",
      "Bash(sudo chown -R *)",
      "Bash(sudo passwd *)",
      "Bash(sudo userdel *)",
      "Bash(sudo deluser *)",
      "Bash(sudo tee /etc/*)",
      "Bash(history -c)"
    ],

    "ask": [
      "Bash(git push *)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(sudo apt install*)",
      "Bash(sudo apt upgrade*)",
      "Bash(sudo systemctl*)",
      "Bash(sudo ufw*)",
      "Bash(sudo iptables*)",
      "Bash(sudo journalctl*)",
      "WebFetch(domain:*)"
    ],

    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(pip install*)",
      "Bash(pip show*)",
      "Bash(make *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit *)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git remote*)"
    ],

    "additionalDirectories": [
      "./docs",
      "./scripts",
      "./memory"
    ]
  },

  "//hooks": "Project-level hooks via flat lifecycle scripts in ./hooks/. Each script reads stdin (Claude Code hook payload as JSON), exits 0 to proceed, exits 2 to block (PreToolUse only).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/boot.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/boot.sh compact",
            "timeout": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/enrich-prompt.sh",
            "timeout": 2000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-edit.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-action.sh",
            "timeout": 10000,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-subagent.sh",
            "timeout": 3000,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/notify-stop.sh",
            "timeout": 3000,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-end.sh",
            "timeout": 3000,
            "async": true
          }
        ]
      }
    ]
  }
}
