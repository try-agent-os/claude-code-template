# AgentOS environment file — example.
#
# This is the shape of /etc/agent-os/agent-os.env that install.sh writes.
# Copy to /etc/agent-os/agent-os.env (mode 0640, owner root:agent-os) if you
# want to skip the wizard prompts and run `install.sh --non-interactive`.
#
# DO NOT commit your real env file. Add to .gitignore.

# ---------------------------------------------------------------------------
# Authentication — REQUIRED. Provide ONE of the two:
# ---------------------------------------------------------------------------

# Long-lived OAuth token (RECOMMENDED) — billed against your Claude.ai plan.
# Generate locally with: `claude setup-token` (browser OAuth, prints 1-year token).
# Required for plan-billed inference (Pro / Max / Team / Enterprise).
CLAUDE_CODE_OAUTH_TOKEN=

# Console-billed API key — pay-per-token. Use only if you don't have a Claude.ai
# subscription. From console.anthropic.com.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Telegram — REQUIRED unless installing with --minimal
# ---------------------------------------------------------------------------

# From @BotFather (`/newbot` → token). Empty string disables the operator agent.
TELEGRAM_BOT_TOKEN=

# Multi-admin allowlist — comma-separated Telegram user IDs that the bot accepts
# messages from. The Mac install wizard auto-detects these via /start polling
# (Step 4b) and passes them through to install.sh. The telegram plugin seeds
# these as 'allowed' in its SQLite users table on startup.
TELEGRAM_ADMIN_USER_IDS=

# Optional, display only — comma-separated usernames parallel to the IDs above.
# Populated by the Mac wizard, not enforced by the bot.
TELEGRAM_ADMIN_USERNAMES=

# Legacy single-admin compat — the first ID from TELEGRAM_ADMIN_USER_IDS. Kept
# for backward compat with older hooks/scripts; new code should read
# TELEGRAM_ADMIN_USER_IDS instead. Get from @userinfobot.
TELEGRAM_USER_ID=

# ---------------------------------------------------------------------------
# AgentOS state paths — set by install.sh, override only if you know why
# ---------------------------------------------------------------------------

DB_PATH=/var/lib/agent-os/saga.db
CLAUDE_PEERS_DB=/var/lib/agent-os/claude-peers.db

# telegram is now a stdio MCP plugin (plugins/telegram). Claude Code spawns
# the subprocess with cwd = plugin install dir, so messages.db lives there.
# Open question (see commit "T06-amend"): patch vendored telegram-mcp source
# to honour ${CLAUDE_PLUGIN_DATA} so the DB lives under STATE_DIR.

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# OpenAI key for any agent that wants GPT (transcription fallback, embeddings, etc.)
OPENAI_API_KEY=

# IANA timezone (e.g. UTC, Europe/Lisbon). install.sh autodetects via timedatectl.
TZ=UTC

# Project slug (used for systemd Description, log prefixes, etc.)
PROJECT_NAME=agentos

# ---------------------------------------------------------------------------
# Behaviour — defense in depth (also enforced via /etc/claude-code/managed-settings.json)
# ---------------------------------------------------------------------------

# Disable in-process auto-update (claude-code apt repo handles updates).
DISABLE_AUTOUPDATER=1

# Don't block claude-code startup if an MCP server is slow to come up.
MCP_CONNECTION_NONBLOCKING=true
