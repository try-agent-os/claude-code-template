{
  "mcpServers": {
    "telegram": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/index.js"],
      "env": {
        "TELEGRAM_BOT_TOKEN": "${userConfig.bot_token}",
        "TELEGRAM_ADMIN_USER_IDS": "${userConfig.admin_user_ids}",
        "TELEGRAM_ADMIN_USERNAMES": "${userConfig.admin_usernames}",
        "PORT": "3848"
      }
    }
  }
}
