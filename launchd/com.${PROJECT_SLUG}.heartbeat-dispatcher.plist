<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.${PROJECT_SLUG}.heartbeat-dispatcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>${INSTALL_ROOT}/claude/agents/heartbeat/dispatcher.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>${INSTALL_ROOT}/claude/agents/heartbeat</string>
	<!-- StartInterval is substituted by install.sh from $DISPATCHER_INTERVAL_SEC (default 2700 = 45 min) -->
	<key>StartInterval</key>
	<integer>2700</integer>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>${LOG_DIR}/dispatcher-errors.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>${AGENT_HOME}</string>
		<key>USER</key>
		<string>${AGENT_USER}</string>
		<key>PATH</key>
		<string>${AGENT_HOME}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>MCP_CONNECTION_NONBLOCKING</key>
		<string>true</string>
		<key>CLAUDE_CONFIG_DIR</key>
		<string>${CLAUDE_CONFIG_DIR}</string>
	</dict>
</dict>
</plist>
