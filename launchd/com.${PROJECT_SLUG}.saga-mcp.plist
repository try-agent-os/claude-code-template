<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.${PROJECT_SLUG}.saga-mcp</string>
	<key>ProgramArguments</key>
	<array>
		<string>${NODE_PATH}</string>
		<string>${INSTALL_ROOT}/saga-mcp/dist/index.js</string>
	</array>
	<key>WorkingDirectory</key>
	<string>${INSTALL_ROOT}/saga-mcp</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>${LOG_DIR}/saga-mcp.log</string>
	<key>StandardErrorPath</key>
	<string>${LOG_DIR}/saga-mcp.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>${AGENT_HOME}</string>
		<key>NODE_ENV</key>
		<string>production</string>
		<key>PORT</key>
		<string>3851</string>
		<key>DB_PATH</key>
		<string>${STATE_DIR}/saga.db</string>
	</dict>
</dict>
</plist>
