<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.${PROJECT_SLUG}.operator</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>${INSTALL_ROOT}/claude/agents/operator/start.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>${INSTALL_ROOT}/claude/agents/operator</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>${LOG_DIR}/operator.log</string>
	<key>StandardErrorPath</key>
	<string>${LOG_DIR}/operator-errors.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>${AGENT_HOME}</string>
		<key>USER</key>
		<string>${AGENT_USER}</string>
		<key>PATH</key>
		<string>${AGENT_HOME}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>TERM</key>
		<string>screen-256color</string>
		<key>CLAUDE_CONFIG_DIR</key>
		<string>${CLAUDE_CONFIG_DIR}</string>
	</dict>
</dict>
</plist>
