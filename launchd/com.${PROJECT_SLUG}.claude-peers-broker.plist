<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.${PROJECT_SLUG}.claude-peers-broker</string>
	<key>ProgramArguments</key>
	<array>
		<string>${BUN_PATH}</string>
		<string>${INSTALL_ROOT}/claude-peers-mcp/broker.ts</string>
	</array>
	<key>WorkingDirectory</key>
	<string>${INSTALL_ROOT}/claude-peers-mcp</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>${LOG_DIR}/claude-peers-broker.log</string>
	<key>StandardErrorPath</key>
	<string>${LOG_DIR}/claude-peers-broker.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>${AGENT_HOME}</string>
	</dict>
</dict>
</plist>
