<?xml version="1.0" encoding="UTF-8"?>
<!--
  AgentOS heartbeat dispatcher launchd plist (macOS).

  Перед использованием:
    1. Замени ВСЕ "/Users/YOU" на абсолютный путь к домашней директории.
    2. Замени "/Users/YOU/Workspaces/agentos" на путь к корню AgentOS-репо.
    3. Скопируй файл в ~/Library/LaunchAgents/agentos.heartbeat-dispatcher.plist
    4. Загрузи: launchctl load ~/Library/LaunchAgents/agentos.heartbeat-dispatcher.plist
    5. Проверь: launchctl list | grep agentos

  StartInterval=3600 (час). Adjust if needed; dispatcher.sh сам throttle'ит до ~90 мин днем.

  Linux/cron equivalent (cron -e):
    */45 * * * * /Users/YOU/Workspaces/agentos/agents/heartbeat/dispatcher.sh
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>agentos.heartbeat-dispatcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/YOU/Workspaces/agentos/agents/heartbeat/dispatcher.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/YOU/Workspaces/agentos/agents/heartbeat</string>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/Workspaces/agentos/logs/dispatcher-errors.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/YOU</string>
		<key>USER</key>
		<string>YOU</string>
		<key>PATH</key>
		<string>/Users/YOU/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>MCP_CONNECTION_NONBLOCKING</key>
		<string>true</string>
		<key>AGENTOS_ROOT</key>
		<string>/Users/YOU/Workspaces/agentos</string>
	</dict>
</dict>
</plist>
