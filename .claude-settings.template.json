{
  "$comment": "Per-agent settings.json (rendered into ${CLAUDE_CONFIG_DIR}/settings.json). Channels + plugin enablement live here in user-scope settings. Substitution variables: ${INSTALL_ROOT}, ${STATE_DIR}.",

  "channelsEnabled": true,
  "skipDangerousModePermissionPrompt": true,

  "allowedChannelPlugins": [
    {"plugin": "claude-peers", "marketplace": "agentos"},
    {"plugin": "telegram", "marketplace": "agentos"}
  ],

  "enabledPlugins": {
    "claude-peers@agentos": true,
    "telegram@agentos": true,
    "agentos-core@agentos": true,
    "template-dev@agentos": true,
    "agent-sdk-dev@agentos": true,
    "code-review@agentos": true,
    "commit-commands@agentos": true,
    "security-guidance@agentos": true
  },

  "extraKnownMarketplaces": {
    "agentos": {
      "source": {
        "source": "directory",
        "path": "${INSTALL_ROOT}/claude"
      }
    }
  },

  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__*",
      "Bash",
      "Read", "Write", "Edit",
      "Glob", "Grep",
      "WebFetch", "WebSearch",
      "TodoWrite", "Task"
    ],
    "deny": []
  }
}
