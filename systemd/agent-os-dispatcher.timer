[Unit]
Description=AgentOS heartbeat dispatcher (periodic trigger)
Documentation=https://github.com/try-agent-os/claude-code-template

[Timer]
# First run 2 minutes after boot to let MCP daemons settle
OnBootSec=2min
# Subsequent runs: every {DISPATCHER_INTERVAL_SEC} seconds since the previous activation
# (matches macOS launchd StartInterval semantics — fires N seconds after the
# previous run *started*, not after it ended)
OnUnitActiveSec={DISPATCHER_INTERVAL_SEC}sec
AccuracySec=1min
Unit=agent-os-dispatcher.service
Persistent=true

[Install]
WantedBy=timers.target
