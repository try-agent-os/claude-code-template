[Unit]
Description=AgentOS operator silence-restart detector (restart operator on TG inactivity)
Documentation=https://github.com/try-agent-os/claude-code-template/blob/main/scripts/operator-autocompact/README.md
After=agent-os-operator.service
# Runs as root because it (a) reads state from /var/lib/agent-os,
# (b) sets a dedup flag chown'd to the agent user, (c) issues
# `systemctl restart agent-os-operator.service`.
#
# Restarting (rather than firing the in-TUI /compact slash command via tmux
# send-keys) gives the operator a fully fresh context window. The SessionStart
# hook injects the recent Telegram thread on boot for continuity.

[Service]
Type=oneshot
User=root
# threshold/cooldown/quiet-hours overrides + OPERATOR_CHAT_ID come from here.
EnvironmentFile={ENV_FILE}
ExecStart={INSTALL_ROOT}/claude/scripts/operator-autocompact/detect-and-restart.sh
StandardOutput=journal
StandardError=journal
