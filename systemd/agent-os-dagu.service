[Unit]
Description=Dagu — local routines (cron) engine for AgentOS
Documentation=https://github.com/dagu-org/dagu
Documentation=https://github.com/try-agent-os/claude-code-template/blob/main/docs/decisions/0001-scheduling-layer-dagu.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={AGENT_USER}
Group={AGENT_USER}
WorkingDirectory={STATE_DIR}/dagu
EnvironmentFile=-{ENV_FILE}
Environment=HOME={AGENT_HOME}
# Unset CLAUDE_CODE_OAUTH_TOKEN so a long-lived inference-only token that may be
# present in {ENV_FILE} (loaded via EnvironmentFile above) does NOT propagate
# into the dagu daemon's environ and from there into every headless `claude`
# step the DAGs spawn. With a stale inference-only token in env those sessions
# run in degraded auth ("Not logged in", rc=1) instead of reaching the model.
# Removing the var lets each step fall back to the full-scope OAuth credentials
# at $CLAUDE_CONFIG_DIR/.credentials.json. NOTE: `Environment=CLAUDE_CODE_OAUTH_TOKEN=`
# (empty value) is NOT enough — claude treats an empty-string env var as "set"
# and falls back to long-lived mode. `UnsetEnvironment=` removes it entirely.
UnsetEnvironment=CLAUDE_CODE_OAUTH_TOKEN
Environment=PATH={AGENT_HOME}/.local/bin:{AGENT_HOME}/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Worker-spawn plane env — provided at the dagu PROCESS level so the DAG YAMLs
# under routines/ carry NO host-specific paths. DAG steps inherit these; each
# host renders its own values, keeping the routines portable.
Environment=CLAUDE_CONFIG_DIR={CLAUDE_CONFIG_DIR_HEARTBEAT}
Environment=TMUX_TMPDIR={AGENT_HOME}/.tmux
Environment=DAGU_HOST=127.0.0.1
Environment=DAGU_PORT=8080
# Dagu binds to 127.0.0.1 only, so no auth is enabled by default. If you expose
# the web UI (e.g. via a reverse proxy / tunnel), set DAGU_AUTH_MODE=basic plus
# DAGU_AUTH_BASIC_USERNAME / DAGU_AUTH_BASIC_PASSWORD in {ENV_FILE}.
Environment=DAGU_DAGS_DIR={INSTALL_ROOT}/claude/routines
Environment=DAGU_LOG_DIR={STATE_DIR}/dagu/logs
Environment=DAGU_DATA_DIR={STATE_DIR}/dagu/data
Environment=DAGU_ADMIN_DATA_DIR={STATE_DIR}/dagu/data
Environment=DAGU_WORK_DIR={INSTALL_ROOT}/claude
ExecStart=/usr/local/bin/dagu start-all
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
