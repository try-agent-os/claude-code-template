[Unit]
Description=AgentOS Dagu scheduler watchdog (one-shot, fired by .timer)
Documentation=https://github.com/try-agent-os/claude-code-template
# Deliberately NOT After=/BindsTo= the dagu unit: this watchdog must run
# out-of-band so it can restart a hung-but-alive scheduler.

[Service]
Type=oneshot
User=root
ExecStart=/bin/bash {INSTALL_ROOT}/claude/scripts/dagu-watchdog.sh
StandardOutput=journal
StandardError=journal

# Watchdog runs as root because it calls `systemctl restart` on the dagu unit.
# Restart loop prevention: the script only acts when the heartbeat file is
# stale, and a fresh restart resets the heartbeat within one DAG tick.
