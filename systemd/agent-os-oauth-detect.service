[Unit]
Description=AgentOS OAuth safety-net — detect config-dir drift (auto-fix) + dead token (alert)
Documentation=https://github.com/try-agent-os/claude-code-template
# Network needed only for the rare forced-refresh attempt + Telegram alert.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={AGENT_USER}
Group={AGENT_USER}
WorkingDirectory={INSTALL_ROOT}/claude
EnvironmentFile=-{ENV_FILE}
Environment=HOME={AGENT_HOME}
Environment=PATH={AGENT_HOME}/.local/bin:{AGENT_HOME}/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Hub model: single real credentials file in {CLAUDE_CONFIG_DIR}; the only
# session config-dir is `server` (no symlink fan-out). Point detect at it.
Environment=OAUTH_CRED_FILE={CLAUDE_CONFIG_DIR}/.credentials.json
Environment=OAUTH_CONFIG_DIRS=server
# Safety-net to the hourly refresher: repairs symlink drift silently and alerts
# the admin on Telegram only when a human /login is truly required.
ExecStart={INSTALL_ROOT}/claude/scripts/oauth-refresh/detect.sh
TimeoutStartSec=60
Nice=10
