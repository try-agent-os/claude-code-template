[Unit]
Description=AgentOS operator watchdog (one-shot, fired by .timer)
Documentation=https://github.com/try-agent-os/claude-code-template
After=agent-os-operator.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/agent-os/claude/scripts/operator-watchdog.sh
StandardOutput=journal
StandardError=journal

# Watchdog runs as root because it calls `systemctl restart` on operator.
# Restart loop prevention is in the script itself (cooldown + state file).
