[Unit]
Description=AgentOS claude-peers broker (peer messaging + summaries)
Documentation=https://github.com/try-agent-os/claude-code-template
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={AGENT_USER}
Group={AGENT_USER}
WorkingDirectory={INSTALL_ROOT}/claude-peers-mcp
EnvironmentFile={ENV_FILE}
Environment=HOME={AGENT_HOME}
ExecStart={BUN_PATH} {INSTALL_ROOT}/claude-peers-mcp/broker.ts
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths={STATE_DIR} {LOG_DIR}

# Logging
StandardOutput=append:{LOG_DIR}/claude-peers.log
StandardError=append:{LOG_DIR}/claude-peers-errors.log

[Install]
WantedBy=multi-user.target
