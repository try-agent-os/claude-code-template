[Unit]
Description=AgentOS operator (Claude Code in tmux, channel-pushed)
Documentation=https://github.com/try-agent-os/claude-code-template
# claude-peers is a stdio MCP plugin (spawned per session). telegram-mcp runs as
# its own systemd service (agent-os-telegram-mcp.service) — operator connects to
# it via SSE per project .mcp.json. Both required up before operator is useful.
After=network-online.target agent-os-saga.service agent-os-telegram-mcp.service
Wants=network-online.target agent-os-saga.service agent-os-telegram-mcp.service

[Service]
Type=forking
User={AGENT_USER}
Group={AGENT_USER}
WorkingDirectory={INSTALL_ROOT}/claude/agents/operator
EnvironmentFile={ENV_FILE}
Environment=HOME={AGENT_HOME}
Environment=TERM=screen-256color
# bun lives under {AGENT_HOME}/.bun/bin from the user-level install in Step 7.
# Without it on PATH, claude-peers' MCP server fails to spawn its broker child:
# `Fatal: Executable not found in $PATH: "bun"`.
Environment=PATH={AGENT_HOME}/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CLAUDE_CONFIG_DIR={CLAUDE_CONFIG_DIR_OPERATOR}
Environment=DISABLE_AUTOUPDATER=1
# Tmux socket lives in $HOME (not /tmp) so PrivateTmp=yes can stay on while
# still letting an interactive shell attach: `tmux -S ~/.tmux/operator.sock attach -t operator`.
# {AGENT_HOME}/.tmux must exist before this unit starts — install.sh creates
# it. We can't ExecStartPre=/bin/mkdir here because ProtectHome=read-only
# blocks the mkdir even with ReadWritePaths={AGENT_HOME}/.tmux (the path
# must exist for ReadWritePaths to take effect).
# `--dangerously-load-development-channels server:<name>` is the syntax that
# bypasses claude-code's plugin-channel allowlist (which is enterprise-gated
# via the `tengu_harbor_ledger` GrowthBook flag). The `server:` prefix matches
# MCP server names from .mcp.json / mcpServers, NOT plugin marketplace IDs.
ExecStart=/usr/bin/tmux -S {AGENT_HOME}/.tmux/operator.sock new-session -d -s operator -c {INSTALL_ROOT}/claude/agents/operator \
  'claude --dangerously-skip-permissions \
    --add-dir {INSTALL_ROOT}/claude/memory \
    --add-dir {INSTALL_ROOT}/claude/agents \
    --dangerously-load-development-channels server:telegram \
    --dangerously-load-development-channels server:claude-peers'
ExecStop=/usr/bin/tmux -S {AGENT_HOME}/.tmux/operator.sock kill-session -t operator
# Auto-dismiss the "Loading development channels" warning dialog. claude-code
# shows it every session when --dangerously-load-development-channels is
# passed; no persistence flag exists in the binary. Default option is
# "1. I am using this for local development" so a single Enter advances.
# Backgrounded (`&`) and disowned so this Post step exits immediately.
ExecStartPost=/bin/bash -c '(sleep 7 && /usr/bin/tmux -S {AGENT_HOME}/.tmux/operator.sock send-keys -t operator Enter 2>/dev/null) & disown'
Restart=on-failure
RestartSec=30

# Hardening
# NoNewPrivileges=no is required: tmux invokes setuid /usr/lib/.../utempter to
# update utmp/wtmp on session create. With NoNewPrivileges=yes utempter fails
# with "pututline: Permission denied" and tmux exits 1, which makes systemd
# tear the unit down (status=1/FAILURE) before claude even gets a pty.
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths={STATE_DIR} {LOG_DIR} {INSTALL_ROOT}/claude {CLAUDE_CONFIG_DIR_OPERATOR} {AGENT_HOME}/.config {AGENT_HOME}/.tmux

# Logging
StandardOutput=append:{LOG_DIR}/operator.log
StandardError=append:{LOG_DIR}/operator-errors.log

[Install]
WantedBy=multi-user.target
