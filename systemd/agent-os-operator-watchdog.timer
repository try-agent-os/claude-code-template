[Unit]
Description=Run AgentOS operator watchdog every 5 minutes
Documentation=https://github.com/try-agent-os/claude-code-template
Requires=agent-os-operator-watchdog.service

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Unit=agent-os-operator-watchdog.service
Persistent=true

[Install]
WantedBy=timers.target
