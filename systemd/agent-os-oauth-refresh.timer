[Unit]
Description=Refresh the Claude CLI OAuth token before it expires (hourly)
Documentation=https://github.com/try-agent-os/claude-code-template
Requires=agent-os-oauth-refresh.service

[Timer]
# Token life is ~8h; the script refreshes when < 2h remain. An hourly tick
# guarantees we always catch the token inside that 2h window with ~1h margin,
# so it can never expire silently between ticks.
OnBootSec=2min
OnUnitActiveSec=1h
# Persistent=true runs a missed tick immediately after downtime/boot — closes
# the gap where the box was off across the expiry window.
Persistent=true
Unit=agent-os-oauth-refresh.service

[Install]
WantedBy=timers.target
