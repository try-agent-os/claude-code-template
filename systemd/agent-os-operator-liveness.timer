[Unit]
Description=Run AgentOS operator liveness watchdog every minute
Documentation=https://github.com/try-agent-os/claude-code-template
Requires=agent-os-operator-liveness.service

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
# AccuracySec keeps the <60s recovery guarantee — systemd otherwise batches
# timers with up to 1min slack, which could stretch a tick to ~2min.
AccuracySec=5s
Unit=agent-os-operator-liveness.service
Persistent=true

[Install]
WantedBy=timers.target
